# Copy this file to .env and fill in the values. Restart Expo after any change.
# These values are public by design. Never put a secret or service_role key here.

# Supabase > Project Settings > API (same values as the website)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The live website. The app calls its /api/checkout endpoint.
EXPO_PUBLIC_API_URL=https://mickyhill-store.vercel.app
